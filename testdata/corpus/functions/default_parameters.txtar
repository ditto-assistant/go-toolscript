Default parameters on a helper.
-- script.js --
function search(query, limit = 5, opts = {since: "2026-01-01"}) {
  return mcp.search_memories({queries: [query], limit, since: opts.since});
}
const a = search("launch");
const b = search("billing", 2, {since: "2026-08-01"});
return [a.args.limit, a.args.since, b.args.limit, b.args.since];
-- tools.json --
{
  "search_memories": null
}
