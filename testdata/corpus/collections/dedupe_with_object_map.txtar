Dedupe by id using an object as a seen-map.
-- script.js --
const a = mcp.search_memories({queries:["billing", "launch", "design"]});
const seen = {};
const out = [];
for (const q of a.queries) for (const h of q.results) {
  if (seen[h.id]) continue;
  seen[h.id] = true;
  out.push(h.id);
}
return out;
