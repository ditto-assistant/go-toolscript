indexOf/lastIndexOf/slice to extract a domain.
-- script.js --
const r = mcp.gmail.fetch_emails({query:"in:inbox"});
return r.messages.map(m => {
  const at = m.from.indexOf("@");
  const dot = m.from.lastIndexOf(".");
  return {domain: m.from.slice(at + 1), tld: m.from.slice(dot + 1), missing: m.from.indexOf("#")};
});
-- tools.json --
