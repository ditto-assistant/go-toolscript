Chunk an id list into batches of N.
-- script.js --
const r = mcp.notes.list_scores({});
const ids = r.items.map(i => i.id);
const chunks = [];
for (let i = 0; i < ids.length; i += 2) chunks.push(ids.slice(i, i + 2));
return chunks;
