`in` operator and hasOwnProperty on results.
-- script.js --
const a = mcp.crm.get_account({id:"acct_9"});
return ["owner" in a, "region" in a, a.hasOwnProperty("tier"), Object.prototype.hasOwnProperty.call(a, "missing")];
-- tools.json --
{
  "crm.get_account": {
    "id": "acct_9",
    "name": "Globex",
    "tier": "enterprise",
    "arr": 125000,
    "owner": {
      "name": "Dana",
      "email": "dana@example.com"
    },
    "contacts": 14
  }
}
