Locale-sensitive APIs: localeCompare and toLocaleString.
-- script.js --
const r = mcp.googledrive.find_file({q: "trashed = false"});
const names = r.files.map(f => f.name).sort((a, b) => a.localeCompare(b));
return {names, big: (1234567.891).toLocaleString()};
