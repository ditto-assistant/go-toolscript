Partition into two arrays with a single reduce.
-- script.js --
const r = mcp.notes.list_scores({});
const [pass, fail] = r.items.reduce(([p, f], i) => i.score >= 0.6 ? [[...p, i.name], f] : [p, [...f, i.name]], [[], []]);
return {pass, fail};
