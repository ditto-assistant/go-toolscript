Date.now() and new Date() for relative time filtering.
-- script.js --
const now = Date.now();
const r = mcp.gmail.fetch_emails({query: "in:inbox"});
const ages = r.messages.map(m => Math.round((now - new Date(m.date).getTime()) / 3600000));
return {count: ages.length, allPositive: ages.every(a => a > 0), iso: new Date(0).toISOString()};
