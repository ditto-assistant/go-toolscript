Locate paragraph indices in a doc, compute a section range, then call an update tool with markdown.
-- script.js --
const id = "doc_abc";
const d = mcp.googledocs.get_document_by_id({id, includeTabsContent: true});
const content = d.tabs[0].documentTab.body.content;
const p = content.filter(x => x.paragraph).map(x => ({
  s: x.startIndex, e: x.endIndex,
  t: (x.paragraph.elements || []).map(el => el.textRun?.content || "").join("").trim(),
  style: x.paragraph.paragraphStyle?.namedStyleType || "NORMAL_TEXT"
}));
const i = p.findIndex(x => x.t.startsWith("Risks"));
const j = p.findIndex((x, k) => k > i && x.style.startsWith("HEADING"));
if (i < 0) return {error: "section not found", headings: p.filter(x => x.style !== "NORMAL_TEXT").map(x => x.t)};
const end = j < 0 ? p[p.length - 1].e : p[j].s;
const rows = [["Hiring slip", "medium", "Alice"], ["Vendor delay", "high", "Bob"]];
const md = `### Risks

| Risk | Severity | Owner |
|---|---|---|
${rows.map(r => `| ${r.join(" | ")} |`).join("\n")}
`;
const res = mcp.googledocs.update_document_section_markdown({document_id: id, tab_id: "t.0", start_index: p[i].s, end_index: end, markdown_text: md});
return {range: [p[i].s, end], replaced: p.slice(i, j < 0 ? undefined : j).map(x => x.t), status: res.status};
