2..7 numeric arguments: NaN, Infinity, fractions, negatives, overflow, two-digit years.
-- script.js --
const show = d => (isNaN(d) ? "Invalid" : d.toISOString() + " " + d.getDay());
const cases = [
  [2020, 0], [2020, 11, 31, 23, 59, 59, 999], [2020, 12], [2020, -1], [2020, 1, 30], [2020, 0, 0], [2020, 0, -365],
  [99, 0], [0, 0], [100, 0], [-1, 0], [-100, 5], [1.9, 0], [2020.9, 0.9, 1.9, 1.9], [2020, 0, 1, 24], [2020, 0, 1, -1],
  [2020, 0, 1, 0, 0, 0, 1e3 * 86400], [2020, 0, 1, 0, 0, 0, -1], [2020, 0, 1, 0, 0, 0, 0.5], [2020, NaN], [NaN, 0],
  [2020, Infinity], [Infinity, 0], [-Infinity, 0], [2020, 0, Infinity], [2020, 0, 1, 0, 0, 0, Infinity], [2020, 0, 1, 0, 0, 0, -Infinity],
  [275760, 8, 13], [275760, 8, 13, 0, 0, 0, 1], [-271821, 3, 20], [-271821, 3, 19], [2020, 1e10], [1e10, 0], [2020, "3", "4"], [2020, 0, 1, 0, 0, 0, 0, NaN]
];
return cases.map(a => show(new Date(...a)));
