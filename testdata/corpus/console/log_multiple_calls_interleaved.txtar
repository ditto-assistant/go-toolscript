Logging interleaved with several tool calls.
-- script.js --
console.log("fetching issues");
const i = mcp.github.search_issues({query:"is:open"});
console.log("issues:", i.result.items.length);
console.log("fetching events");
const e = mcp.googlecalendar.events_list({calendarId:"primary"});
console.log("events:", e.items.length);
return "ok";
