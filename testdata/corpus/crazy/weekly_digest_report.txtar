Fetch several sources, normalize, rank and render a markdown digest with truncation.
-- script.js --
const since = "2026-09-18";
const mem = mcp.search_memories({queries: ["decisions this week", "blockers", "launch"], since, limit: 10});
const prs = mcp.github.list_pull_requests({owner: "acme", repo: "widget-service", state: "all"});
const issues = mcp.linear.list_issues({team: "ENG", first: 50});
const mail = mcp.gmail.fetch_emails({query: "newer_than:7d", max_results: 20});

const memHits = [];
const seen = {};
for (const q of mem.queries) {
  for (const r of q.results) {
    if (seen[r.id]) continue;
    seen[r.id] = 1;
    memHits.push({id: r.id, text: r.summary, score: r.score, q: q.query || ("q" + q.query_index)});
  }
}
memHits.sort((a, b) => b.score - a.score || (a.id < b.id ? -1 : 1));

const openPrs = prs.filter(p => p.state === "open");
const drafts = openPrs.filter(p => p.draft).length;
const byState = issues.nodes.reduce((acc, n) => { acc[n.state.name] = (acc[n.state.name] || 0) + 1; return acc; }, {});
const unread = mail.messages.filter(m => (m.labelIds || []).includes("UNREAD"));

const lines = [];
lines.push(`# Weekly digest (since ${since})`);
lines.push("");
lines.push("## Memory highlights");
for (const h of memHits.slice(0, 5)) lines.push(`- (${h.score.toFixed(2)}) ${h.text}`);
lines.push("");
lines.push(`## Pull requests: ${openPrs.length} open (${drafts} draft)`);
for (const p of openPrs) lines.push(`- #${p.number} ${p.title} — @${p.user.login}${p.labels.length ? " [" + p.labels.map(l => l.name).join(", ") + "]" : ""}`);
lines.push("");
lines.push("## Issues by state");
for (const k of Object.keys(byState).sort()) lines.push(`- ${k}: ${byState[k]}`);
lines.push("");
lines.push(`## Inbox: ${unread.length} unread of ${mail.messages.length}`);
unread.forEach(m => lines.push(`- ${m.from}: ${m.subject}`));
const report = lines.join("\n");
return report.length > 3000 ? report.slice(0, 3000) + "\n…(truncated)" : report;
