Logs results of comparisons on tool data.
-- script.js --
const a = mcp.crm.get_account({id:"acct_9"});
console.log("enterprise?", a.tier === "enterprise");
console.log("big?", a.arr >= 100000, "contacts>20?", a.contacts > 20);
return a.tier;
