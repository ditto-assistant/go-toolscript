JSON.stringify(result).slice(0, 6000) - the most common truncation idiom.
-- script.js --
const r = mcp.github.search_issues({owner:"acme", repo:"widget-app", query:"composer focus", perPage:10});
return JSON.stringify(r).slice(0, 6000);
