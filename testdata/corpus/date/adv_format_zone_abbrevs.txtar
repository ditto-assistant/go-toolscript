toString/toTimeString zone abbreviations and offsets across the year and historical dates.
-- script.js --
const ts = [Date.UTC(2026, 0, 15, 12), Date.UTC(2026, 6, 15, 12), Date.UTC(2026, 2, 8, 7), Date.UTC(2026, 3, 4, 15, 30), Date.UTC(2026, 9, 3, 15, 45), Date.UTC(1883, 10, 18, 17), Date.UTC(1900, 0, 1), Date.UTC(1941, 9, 1), Date.UTC(1970, 0, 1), Date.UTC(2038, 0, 19, 3, 14, 8), Date.UTC(2100, 6, 1)];
return ts.map(t => { const d = new Date(t); return [d.toString(), d.toTimeString(), d.getTimezoneOffset(), d.getHours(), d.getMinutes(), d.getSeconds()]; });
