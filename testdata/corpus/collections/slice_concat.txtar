slice and concat for top-N plus tail.
-- script.js --
const r = mcp.notes.list_scores({});
const top = r.items.slice(0, 2);
const rest = r.items.slice(2);
const combined = top.concat([{id: "sep"}], rest.slice(-1));
return combined.map(i => i.id);
