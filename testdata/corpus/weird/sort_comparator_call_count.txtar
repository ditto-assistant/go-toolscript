Model counts comparator invocations and logs each comparison while sorting.
-- script.js --
const xs = mcp.nums.get({}).xs;
let calls = 0;
const log = [];
const sorted = xs.slice().sort((a, b) => { calls++; if (log.length < 6) log.push(`${a}?${b}`); return a - b; });
console.log("comparisons", calls);
return {sorted, calls, log};
