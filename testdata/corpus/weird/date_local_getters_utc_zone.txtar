Local-time getters and toString forms in the runner zone for dates parsed from mixed strings.
-- script.js --
const ds = mcp.cal.dates({}).dates.map(s => new Date(s));
return ds.map(d => isNaN(d) ? String(d) : [d.getFullYear(), d.getMonth(), d.getDate(), d.getDay(), d.getHours(), d.getTimezoneOffset(), d.toDateString(), d.toISOString(), d.toJSON(), d.toUTCString(), String(d).slice(0, 24)].join("|"));
-- tools.json --
{
  "cal.dates": {
    "dates": [
      "2026-03-08T07:30:00Z",
      "2026-11-01 01:30",
      "Sep 26, 2026",
      "2026/09/26 10:00",
      "Sat, 26 Sep 2026 14:30:15 GMT",
      "2026-09-26T14:30:15.123456Z",
      "20260926",
      "2026-9-6"
    ]
  }
}
