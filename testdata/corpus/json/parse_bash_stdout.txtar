JSON.parse of bash stdout (ignoring the .json convenience field).
-- script.js --
const x = bash("jq -c '[.items[] | {id, score}]' /results/002-notes-list-scores.json");
const arr = JSON.parse(x.stdout);
return arr.filter(i => i.score > 0.5).map(i => i.id);
