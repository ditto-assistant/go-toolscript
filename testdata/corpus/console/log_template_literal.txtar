console.log with template literals interpolating tool data.
-- script.js --
const r = mcp.gmail.fetch_emails({query:"is:unread"});
for (const m of r.messages) {
  console.log(`${m.id} | ${m.from} | ${m.subject}`);
}
return `${r.messages.length} messages`;
