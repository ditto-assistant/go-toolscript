Multi-key comparator with a full tie-break.
-- script.js --
const r = mcp.notes.list_scores({});
const sorted = [...r.items].sort((a, b) => {
  if (a.team !== b.team) return a.team < b.team ? -1 : 1;
  if (b.score !== a.score) return b.score - a.score;
  return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
});
return sorted.map(i => `${i.team}/${i.name}`);
