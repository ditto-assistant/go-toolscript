Moving averages, percent change and trend classification over several metric series.
-- script.js --
const series = mcp.crm.get_timeseries({metrics: ["signups", "churn", "latency_ms"], days: 10}).series;
const ma = (xs, w) => xs.map((_, i) => i + 1 < w ? null : xs.slice(i + 1 - w, i + 1).reduce((a, b) => a + b, 0) / w);
const out = {};
for (const [name, pts] of Object.entries(series)) {
  const vals = pts.map(p => p.v);
  const m3 = ma(vals, 3).filter(v => v !== null);
  const first = m3[0], last = m3[m3.length - 1];
  const change = first ? (last - first) / first : 0;
  const goodWhenUp = name === "signups";
  const trend = Math.abs(change) < 0.05 ? "flat" : (change > 0) === goodWhenUp ? "improving" : "worsening";
  const peak = pts.reduce((b, p) => p.v > b.v ? p : b);
  out[name] = {last: vals[vals.length - 1], ma3: Number(last.toFixed(2)), change: (change * 100).toFixed(1) + "%", trend, peakDay: peak.d};
}
return out;
