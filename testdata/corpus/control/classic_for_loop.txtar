Classic indexed for loop over a result array.
-- script.js --
const prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service", state:"all"});
const titles = [];
for (let i = 0; i < prs.length; i++) {
  if (prs[i].state !== "open") continue;
  titles.push("#" + prs[i].number + " " + prs[i].title);
}
return titles;
