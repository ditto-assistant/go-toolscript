Flatten a comment tree to rows with parent ids, then rebuild it from the rows and compare JSON.
-- script.js --
const doc = mcp.docs.get({id: "doc_abc"});
let seq = 0;
const rows = [];
const flat = (node, parent) => { if (!node || typeof node !== "object") return; const id = "n" + ++seq; rows.push({id, parent, type: node.type ?? null, text: node.text ?? null}); (node.children ?? []).forEach(c => flat(c, id)); (node.replies ?? []).forEach(c => flat(c, id)); };
doc.blocks.forEach(b => flat(b, null));
const byId = Object.fromEntries(rows.map(r => [r.id, {...r, kids: []}]));
const roots = [];
for (const r of rows) (r.parent ? byId[r.parent].kids : roots).push(byId[r.id]);
const strip = n => ({t: n.type, k: n.kids.map(strip)});
return {n: rows.length, shape: JSON.stringify(roots.map(strip)), parents: rows.filter(r => !r.parent).map(r => r.id)};
