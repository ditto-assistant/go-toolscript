new Date over tool-result objects, arrays and numeric fields.
-- script.js --
const s = mcp.stats.get({});
const show = d => (isNaN(d) ? "Invalid" : d.toISOString());
return [show(new Date(s.ts)), show(new Date(s.sec * 1000)), show(new Date(s.parts)), show(new Date(...s.parts)), show(new Date(s.obj)), show(new Date(s)), show(new Date(s.iso)), show(new Date(s.neg)), show(new Date(s.float)), show(new Date(s.missing))];
