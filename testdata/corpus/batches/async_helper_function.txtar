Named async function declared and awaited multiple times.
-- script.js --
async function titleOf(id) {
  const d = await mcp.googledocs.get_document_by_id({id});
  return d.title;
}
const a = await titleOf("doc_abc");
const b = await titleOf("doc_def");
return [a, b];
