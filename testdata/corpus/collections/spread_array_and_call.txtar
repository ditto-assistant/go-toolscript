Array spread and spread into Math.max/min.
-- script.js --
const r = mcp.notes.list_scores({});
const scores = r.items.map(i => i.score);
return {max: Math.max(...scores), min: Math.min(...scores), all: [...scores, ...[1]].length, emptyMax: Math.max()};
