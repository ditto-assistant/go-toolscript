Throwing a string literal and catching it.
-- script.js --
try {
  const t = mcp.call("mcp__acme-tracker__list_tickets", {});
  if (!t.tickets.some(x => x.status === "urgent")) throw "no urgent tickets";
  return "urgent found";
} catch (e) {
  return typeof e + ": " + e;
}
