Cursor pagination with $sequence, dedupe across overlapping pages, then aggregate by label.
-- script.js --
const all = [];
const seen = {};
let cursor = null, pages = 0;
while (true) {
  const page = mcp.linear.list_issues({team: "ENG", first: 2, after: cursor});
  pages++;
  for (const n of page.nodes) {
    if (seen[n.identifier]) continue;
    seen[n.identifier] = true;
    all.push(n);
  }
  if (!page.pageInfo.hasNextPage || pages >= 20) break;
  cursor = page.pageInfo.endCursor;
}
const byLabel = {};
for (const n of all) {
  const labels = n.labels.length ? n.labels : ["(none)"];
  for (const l of labels) {
    byLabel[l] = byLabel[l] || {count: 0, open: 0, ids: []};
    byLabel[l].count++;
    if (n.state.name !== "Done") byLabel[l].open++;
    byLabel[l].ids.push(n.identifier);
  }
}
return {pages, total: all.length, byLabel};
