Every constructor form, including invalid inputs and year 0-99 mapping.
-- script.js --
const forms = [
  new Date(0), new Date(1700000000000), new Date(-1), new Date(8.64e15), new Date(8.64e15 + 1),
  new Date(2026, 0, 31), new Date(2026, 1, 30), new Date(99, 11, 31, 23, 59, 59, 999), new Date(2026, 12), new Date(2026, -1, 1),
  new Date(2026, 8, 26, 25, 61, 61, 1001), new Date("2026-09-26"), new Date("2026-09-26T10:20"), new Date("2026-09-26T10:20:30.5Z"),
  new Date("2026-09-26T10:20:30+05:30"), new Date("not a date"), new Date(NaN), new Date(Infinity), new Date(""), new Date(true), new Date(null), new Date("0"),
];
return forms.map(d => [String(d), d.getTime(), isNaN(d)]);
