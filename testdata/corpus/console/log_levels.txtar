info/warn/error/debug are all captured.
-- script.js --
const t = mcp.call("mcp__acme-tracker__list_tickets", {});
console.info("tickets", t.tickets.length);
console.warn("high priority:", t.tickets.filter(x => x.priority === "high").length);
console.error("closed:", t.tickets.filter(x => x.status === "closed").map(x => x.id).join(","));
console.debug("debug line");
return "logged";
