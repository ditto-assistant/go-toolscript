startsWith/endsWith on subjects and filenames.
-- script.js --
const r = mcp.googledrive.find_file({q:"trashed = false"});
return {
  re: mcp.gmail.fetch_emails({query:"in:inbox"}).messages.filter(m => m.subject.startsWith("Re:")).length,
  xlsx: r.files.filter(f => f.name.endsWith(".xlsx")).map(f => f.name),
  offset: "widget-service".startsWith("service", 7)
};
