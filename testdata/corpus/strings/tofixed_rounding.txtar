toFixed and Math.round for percentage formatting.
-- script.js --
const r = mcp.linear.list_issues({team:"ENG"});
const done = r.nodes.filter(n => n.state.name === "Done").length;
const pct = done / r.nodes.length * 100;
return [pct.toFixed(1) + "%", (2/3).toFixed(3), Math.round(pct * 10) / 10, (1234.56).toFixed(0), (0.000123).toFixed(5)];
