Promise.allSettled where one call fails via $error.
-- script.js --
const settled = await Promise.allSettled([
  mcp.fetch_memories({ids: ["mem_001"]}),
  mcp.call("mcp__acme-tracker__list_tickets", {}),
  mcp.googlecalendar.events_list({calendarId: "primary"})
]);
return settled.map(s => s.status === "fulfilled" ? "ok" : "failed: " + String(s.reason && s.reason.message || s.reason));
