mcp.call with a raw namespaced tool name.
-- script.js --
const t = mcp.call("mcp__acme-tracker__list_tickets", {status: "open", limit: 25});
return t;
-- tools.json --
{
  "mcp__acme-tracker__list_tickets": {
    "tickets": [
      {
        "id": "T-1",
        "subject": "Cannot log in",
        "status": "open",
        "priority": "high",
        "customer": "acme"
      },
      {
        "id": "T-2",
        "subject": "Export is slow",
        "status": "pending",
        "priority": "normal",
        "customer": "globex"
      },
      {
        "id": "T-3",
        "subject": "Typo on invoice",
        "status": "closed",
        "priority": "low",
        "customer": "acme"
      }
    ]
  }
}
