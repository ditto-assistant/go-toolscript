Reading a property of undefined inside try is caught.
-- script.js --
const r = mcp.crm.get_account({id:"acct_9"});
try {
  return r.billing.plan.name;
} catch (e) {
  return {error: e instanceof TypeError ? "TypeError" : "other", has: Object.keys(r).length};
}
