Promise.all with three calls across bindings styles.
-- script.js --
const [mem, tickets, review] = await Promise.all([
  mcp.search_memories({queries: ["customer escalations"], limit: 5}),
  mcp.call("mcp__acme-tracker__list_tickets", {status: "open"}),
  mcp["team-backroom"].get_review({submissionId: "sub_77"})
]);
return {
  memories: mem.queries[0].results.map(r => r.id),
  open: tickets.tickets.filter(t => t.status === "open").length,
  review: review.status
};
