while loop paginating with a cursor via $sequence.
-- script.js --
let page = mcp.googledrive.find_file({q:"trashed = false", pageSize:2});
const names = page.files.map(f => f.name);
let guard = 0;
while (page.nextPageToken && guard < 10) {
  page = mcp.googledrive.find_file({q:"trashed = false", pageSize:2, pageToken: page.nextPageToken});
  names.push(...page.files.map(f => f.name));
  guard++;
}
return {names, pages: guard + 1};
