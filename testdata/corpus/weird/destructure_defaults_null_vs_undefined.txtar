Destructuring defaults apply for undefined but not null; renames and nested defaults from sparse tool JSON.
-- script.js --
const r = mcp.user.get({});
const {name: displayName = "anon", limit = 10, tags: [first = "none"], prefs: {theme = "light", lang: language = "en"} = {}, nested: {deep: {value = "dv"} = {}} = {}} = r;
const [head, ...tail] = r.tags;
const [a = 1, b = a * 2, c = b + 1] = r.triple;
const [x, , z = "zdef", ...others] = r.list;
const [p1, p2] = "😀a";
const {length} = r.list;
const {0: zeroth, [r.list.length - 1]: lastItem} = r.list;
return {displayName, limit, first, head, tail, theme, language, value, a, b, c, x, z, others, p1, p2, length, zeroth, lastItem};
-- tools.json --
{
  "user.get": {
