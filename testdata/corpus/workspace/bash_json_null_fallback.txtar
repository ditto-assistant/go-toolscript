  "jq -c '.files | map(.name)' /results/001-googledrive-find-file.json": {
    "stdout": "[\"budget.xlsx\",\"Roadmap\",\"Archive\"]\n",
    "stderr": "",
    "exit_code": 0,
    "json": null
  }
}
