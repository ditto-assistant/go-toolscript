Interleaves a tool call, a bash reshape, and a final tool write.
-- script.js --
const r = mcp.github.list_pull_requests({owner: "acme", repo: "widget-service", state: "open"});
const x = bash("jq -r 'map(\"- #\\(.number) \\(.title)\") | join(\"\\n\")'", r);
const note = mcp.notes.create({title: "Open PRs", body: x.stdout});
return note.args.body;
