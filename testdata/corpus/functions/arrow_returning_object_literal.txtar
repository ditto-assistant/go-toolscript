Arrow functions returning object literals with parens.
-- script.js --
const r = mcp.googlecalendar.events_list({calendarId:"primary"});
return r.items.map(e => ({title: e.summary, allDay: !e.start.dateTime, people: (e.attendees || []).length}));
-- tools.json --
{
  "googlecalendar.events_list": {
    "items": [
      {
        "id": "ev_1",
        "summary": "Team sync",
        "start": {
          "dateTime": "2026-09-25T15:00:00Z"
        },
        "end": {
          "dateTime": "2026-09-25T15:30:00Z"
        },
        "attendees": [
          {
            "email": "alice@example.com"
          },
          {
            "email": "bob@example.com"
          }
        ]
      },
      {
        "id": "ev_2",
