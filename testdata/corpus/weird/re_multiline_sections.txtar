Split a markdown doc into sections using ^## with the m flag and lookahead-free parsing.
-- script.js --
const md = mcp.docs.markdown({}).md;
const heads = [...md.matchAll(/^(#{1,3})\s+(.+?)\s*#*$/gm)].map(m => ({level: m[1].length, title: m[2], at: m.index}));
const sections = heads.map((h, i) => ({...h, body: md.slice(h.at, i + 1 < heads.length ? heads[i + 1].at : md.length).split("\n").slice(1).join("\n").trim()}));
const todos = (md.match(/^\s*[-*] \[ \] .+$/gm) || []).map(s => s.trim());
return {sections: sections.map(s => [s.level, s.title, s.body.length]), todos};
-- tools.json --
{
  "docs.markdown": {
    "md": "# Title #\nintro\n## Tasks\n- [ ] one\n- [x] two\n  * [ ] nested three\n### Deep ###\ntext\n## Notes\n\n```\n# not a heading? (it is, regex does not know)\n```\n"
  }
}
