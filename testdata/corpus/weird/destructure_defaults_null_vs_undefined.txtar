    "limit": null,
    "tags": [
      null,
      "t2",
      "t3"
    ],
    "prefs": {
      "theme": null
    },
    "nested": {
      "deep": null
    },
    "triple": [
      null
    ],
    "list": [
      "l0",
      "l1",
      null,
      "l3",
      "l4"
    ]
  }
}
