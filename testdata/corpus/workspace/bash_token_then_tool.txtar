bash extracts a page token that feeds the next tool call (with timeout option).
-- script.js --
const tok = bash("jq -r '.nextPageToken // empty' /results/007-googledrive-find-file.json", undefined, {timeout_ms:5000}).stdout.trim(); return mcp.googledrive.find_file({q:"trashed = false", pageSize:100, pageToken:tok, orderBy:"modifiedTime desc"});
-- tools.json --
{
  "googledrive.find_file": {
