typeof checks on an un-awaited async helper result and a raw tool promise.
-- script.js --
async function load() { const r = await mcp.items.get({}); return r.v; }
const p = load();
const q = mcp.items.get({});
const info = [typeof p, typeof q, typeof p.then, typeof q.then];
const v = await p;
return {info, v, q: (await q).v};
-- tools.json --
{
  "items.get": {
    "v": 7
  }
}
