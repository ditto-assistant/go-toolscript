Sloppy-mode `with` statement over a tool result.
-- script.js --
const a = mcp.crm.get_account({id: "acct_9"});
with (a) {
  return name + " / " + tier;
}
-- tools.json --
{
  "crm.get_account": {
    "id": "acct_9",
    "name": "Globex",
    "tier": "enterprise",
    "arr": 125000,
    "owner": {
      "name": "Dana",
      "email": "dana@example.com"
    },
    "contacts": 14
  }
}
