else-if chain classifying a score.
-- script.js --
const r = mcp["team-backroom"].get_review({submissionId:"sub_77"});
let band;
if (r.score >= 0.9) band = "excellent";
else if (r.score >= 0.7) band = "good";
else if (r.score >= 0.5) band = "fair";
else band = "poor";
return band;
