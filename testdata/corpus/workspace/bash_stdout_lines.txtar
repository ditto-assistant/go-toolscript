Split bash stdout into lines and parse TSV columns.
-- script.js --
const x = bash("jq -r '.items[] | [.id, .score] | @tsv' /results/002-notes-list-scores.json");
return x.stdout.trim().split("\n").map(l => { const [id, s] = l.split("\t"); return {id, score: Number(s)}; }).filter(r => r.score > 0.5);
