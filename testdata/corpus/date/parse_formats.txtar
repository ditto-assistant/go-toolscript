Date.parse over ISO and legacy formats Goja accepts.
-- script.js --
const inputs = ["2026-09-26", "2026-09", "2026", "+002026-09-26T00:00:00Z", "-000001-01-01T00:00:00Z", "2026-09-26T24:00:00Z", "2026-09-26T24:00:01Z",
  "Sat Sep 26 2026 10:20:30 GMT+0200", "Sat, 26 Sep 2026 10:20:30 GMT", "26 Sep 2026", "Sep 26, 2026", "September 26 2026 3:04 pm", "2026/09/26", "09/26/2026", "9/26/26", "9/26/49", "9/26/50",
  "2026-09-26 10:20:30", "Sep 26 2026 10:20:30 EST", "Sep 26 2026 10:20 PDT", "12:00 am Sep 26 2026", "Sep 26 2026 (comment) 10:00", "2026-02-30", "2026-13-01", "junk", "", "2026-09-26T10:20:30.123456789Z"];
return inputs.map(s => [s, Date.parse(s)]);
