Search memories with many queries, fetch full records in chunks, cluster by tag, summarize per cluster.
-- script.js --
const queries = ["launch", "billing", "hiring", "vendors", "process"];
const s = mcp.search_memories({queries, limit: 5});
const scoreById = {};
s.queries.forEach(q => q.results.forEach(r => { scoreById[r.id] = Math.max(scoreById[r.id] || 0, r.score); }));
const ids = Object.keys(scoreById).sort();
const full = [];
for (let i = 0; i < ids.length; i += 3) {
  const chunk = ids.slice(i, i + 3);
  const r = mcp.fetch_memories({ids: chunk});
  full.push(...r.memories);
}
const clusters = {};
for (const m of full) {
  const tags = m.tags && m.tags.length ? m.tags : ["untagged"];
  for (const t of tags) {
    const c = clusters[t] || (clusters[t] = {n: 0, best: null, words: 0});
    c.n++;
    c.words += m.content.split(" ").filter(Boolean).length;
    if (!c.best || scoreById[m.id] > scoreById[c.best]) c.best = m.id;
  }
}
const lines = Object.entries(clusters)
  .sort((a, b) => b[1].n - a[1].n || (a[0] < b[0] ? -1 : 1))
  .map(([t, c]) => `${t}: ${c.n} memories, ~${Math.round(c.words / c.n)} words avg, best=${c.best}`);
return {ids: ids.length, fetchedChunks: Math.ceil(ids.length / 3), lines};
