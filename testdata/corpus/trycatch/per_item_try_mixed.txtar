Per-item try with one tool failing and another succeeding.
-- script.js --
const out = [];
for (const name of ["events", "tickets"]) {
  try {
    if (name === "events") out.push(mcp.googlecalendar.events_list({calendarId:"primary"}).items.length);
    else out.push(mcp.call("mcp__acme-tracker__list_tickets", {}).tickets.length);
  } catch (e) {
    out.push("ERR " + e.message);
  }
}
return out;
-- tools.json --
