Uses every binding style in one script (flat, server.tool, bracket, tools alias, mcp.call) with bash and console.
-- script.js --
const report = {};
const mem = mcp.search_memories({queries: ["status"], limit: 3});
report.memory = mem.queries[0].results.length;
const cal = mcp.googlecalendar.events_list({calendarId: "primary"});
report.events = cal.items.length;
const rev = mcp["team-backroom"].get_review({submissionId: "sub_77"});
report.review = rev.status;
const alias = tools.fetch_memories({ids: mem.queries[0].results.map(r => r.id)});
report.fetched = alias.memories.length;
const raw = mcp.call("mcp__acme-tracker__list_tickets", {status: "open"});
report.tickets = raw.tickets.length;
const aliasServer = tools.crm.get_account({id: "acct_9"});
report.account = aliasServer.name;
const shaped = bash("jq -c '{n: (.tickets | length), open: [.tickets[] | select(.status == \"open\") | .id]}'", raw);
report.shaped = shaped.json;
console.log("report keys:", Object.keys(report).join(","));
return JSON.stringify(report, null, 2).slice(0, 6000);
