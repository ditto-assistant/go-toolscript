Two independent calls combined into one returned object.
-- script.js --
const mem=mcp.search_memories({queries:["launch plan", "owner of billing"],limit:10}); const docs=mcp.googledocs.search_documents({query:"fullText contains 'launch'",max_results:50}); return {mem,docs};
