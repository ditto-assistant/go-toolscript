workspace_files() filtered by size and mapped to paths.
-- script.js --
const files = workspace_files();
const big = files.filter(f => f.bytes > 5000).map(f => f.path);
const total = files.reduce((s, f) => s + f.bytes, 0);
return {count: files.length, big, totalKb: Math.round(total / 1024)};
