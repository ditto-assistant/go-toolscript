Parse ISO times by hand (no Date), detect overlaps, compute free slots.
-- script.js --
const ev = mcp.googlecalendar.events_list({calendarId: "primary", timeMin: "2026-09-25T00:00:00Z", timeMax: "2026-09-26T00:00:00Z"}).items;
const toMin = iso => { const t = iso.split("T")[1]; const [h, m] = t.split(":"); return Number(h) * 60 + Number(m); };
const fmt = m => String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0");
const timed = ev.filter(e => e.start.dateTime).map(e => ({id: e.id, title: e.summary, s: toMin(e.start.dateTime), e: toMin(e.end.dateTime)}))
  .sort((a, b) => a.s - b.s || a.e - b.e || (a.id < b.id ? -1 : 1));
const conflicts = [];
for (let i = 0; i < timed.length; i++) {
  for (let j = i + 1; j < timed.length && timed[j].s < timed[i].e; j++) {
    conflicts.push(`${timed[i].title} overlaps ${timed[j].title} (${fmt(timed[j].s)}-${fmt(Math.min(timed[i].e, timed[j].e))})`);
  }
}
const free = [];
let cursor = 9 * 60;
for (const t of timed) {
  if (t.s > cursor) free.push(`${fmt(cursor)}-${fmt(t.s)}`);
  cursor = Math.max(cursor, t.e);
}
if (cursor < 18 * 60) free.push(`${fmt(cursor)}-18:00`);
const allDay = ev.filter(e => !e.start.dateTime).map(e => e.summary);
return {conflicts, free, allDay, busyMinutes: timed.reduce((s, t) => s + (t.e - t.s), 0)};
