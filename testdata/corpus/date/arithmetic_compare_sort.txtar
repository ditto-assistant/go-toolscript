Date arithmetic, comparisons, equality and sorting.
-- script.js --
const r = mcp.tickets.list({});
const parsed = r.tickets.map(t => ({id: t.id, at: new Date(t.created_at)}));
parsed.sort((a, b) => a.at - b.at);
const first = parsed[0].at, last = parsed[parsed.length - 1].at;
const days = Math.round((last - first) / 864e5);
const sameInstant = new Date(first.getTime());
return {order: parsed.map(p => p.id), days, lt: first < last, gt: first > last, eqRef: first == sameInstant, eqStrict: first === sameInstant, eqTime: +first === +sameInstant,
  plus: first + 1, minus: last - 1, num: Number(first), cmpStr: String(first) < String(last), max: new Date(Math.max(...parsed.map(p => p.at))).toISOString()};
