          },
          {
            "id": "c2"
          }
        ],
        "next_cursor": "cur_2"
      },
      {
        "contacts": [
          {
            "id": "c2",
            "email": "dup@example.com"
          },
          {
            "id": "c3",
            "email": "carol@example.com"
          }
        ],
        "next_cursor": "cur_3"
      },
      {
        "contacts": [],
        "next_cursor": ""
      }
    ]
  }
}
