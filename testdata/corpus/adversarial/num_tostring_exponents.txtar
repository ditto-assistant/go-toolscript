Number to string around the exponent thresholds in templates and String().
-- script.js --
const xs = [1e21, 1e20, 123456789012345680000, 1e-6, 1e-7, 0.000001234, 1.5e-10, 2**64, -1e21, 5e-324, 1.7976931348623157e308, 0.1+0.2, 100/3];
return xs.map(x => `${x}|${String(x)}|${x + ""}`);
