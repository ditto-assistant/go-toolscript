Multi-line template literal report.
-- script.js --
const a = mcp.crm.get_account({id:"acct_9"});
return `Account: ${a.name}
Tier: ${a.tier.toUpperCase()}
ARR: $${a.arr}
Owner: ${a.owner.name} <${a.owner.email}>`;
