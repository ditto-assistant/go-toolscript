find/findIndex including the not-found case.
-- script.js --
const r = mcp.notes.list_scores({});
const c = r.items.find(i => i.name === "charlie");
const idx = r.items.findIndex(i => i.team === "green");
const none = r.items.find(i => i.name === "zulu");
const noneIdx = r.items.findIndex(i => i.score > 5);
return {c: c.id, idx, none: none === undefined, noneIdx};
