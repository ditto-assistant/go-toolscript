-- script.js --
const prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service", state:"all"});
const open = prs.filter(p => p.state === "open");
return `${open.length} open PR${open.length === 1 ? "" : "s"}: ${open.map(p => `#${p.number}`).join(", ")}`;
