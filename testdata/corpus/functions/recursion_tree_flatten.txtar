Recursive flatten of a folder tree.
-- script.js --
const tree = mcp.googledrive.list_tree({root: "root"});
function flatten(node, depth, out) {
  out.push("  ".repeat(depth) + node.name);
  for (const c of node.children || []) flatten(c, depth + 1, out);
  return out;
}
return flatten(tree, 0, []).join("\n");
-- tools.json --
