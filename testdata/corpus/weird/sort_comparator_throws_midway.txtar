Comparator throws on a malformed row after some swaps; model catches and returns the partially sorted in-place array.
-- script.js --
const rows = mcp.board.list({}).rows;
try {
  rows.sort((a, b) => { if (a.score == null || b.score == null) throw new Error("bad row " + (a.score == null ? a.id : b.id)); return a.score - b.score; });
} catch (e) {
  return {err: e.message, order: rows.map(r => r.id)};
}
return {order: rows.map(r => r.id)};
