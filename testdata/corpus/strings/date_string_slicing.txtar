ISO timestamp strings manipulated without Date.
-- script.js --
const ev = mcp.googlecalendar.events_list({calendarId:"primary"}).items;
return ev.map(e => {
  const iso = e.start.dateTime || (e.start.date + "T00:00:00Z");
  const [day, time] = iso.split("T");
  return {day, hhmm: time.slice(0, 5), month: Number(day.split("-")[1])};
});
