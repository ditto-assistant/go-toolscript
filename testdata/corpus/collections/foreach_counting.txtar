forEach counting into an object.
-- script.js --
const r = mcp.notes.list_scores({});
const tagCounts = {};
r.items.forEach(i => i.tags.forEach(t => { tagCounts[t] = (tagCounts[t] || 0) + 1; }));
return tagCounts;
