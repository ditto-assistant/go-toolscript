TypeError messages for many call-target shapes a model produces.
-- script.js --
const r = mcp.crm.get({});
const out = [];
const tryIt = (label, f) => { try { f(); out.push(label + ": ok"); } catch (e) { out.push(label + ": " + e.name + ": " + e.message); } };
tryIt("computed", () => r.items[0].fmt());
tryIt("keyed", () => r["items"][1]["render"]());
tryIt("or", () => (r.missing || r.count).trim());
tryIt("callres", () => r.items.find(x => x.id === "zz").name);
tryIt("numMethod", () => r.count.toUpperCase());
tryIt("boolMethod", () => r.flag.map(x => x));
tryIt("nullMethod", () => r.nothing.toString());
tryIt("strAsFn", () => r.items[0].id());
tryIt("iife", () => (void 0)());
return out;
-- tools.json --
{
  "crm.get": {
    "items": [
      {
        "id": "a"
      },
      {
        "id": "b"
      }
    ],
    "count": 3,
    "flag": true,
    "nothing": null
  }
}
