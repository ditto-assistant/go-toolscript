Recursive leaf counter with an arrow function referencing itself.
-- script.js --
const tree = mcp.googledrive.list_tree({root: "root"});
const leaves = n => (n.children && n.children.length) ? n.children.reduce((s, c) => s + leaves(c), 0) : 1;
const depth = n => 1 + Math.max(0, ...(n.children || []).map(depth));
return {leaves: leaves(tree), depth: depth(tree)};
