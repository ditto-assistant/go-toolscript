Small arrow helper reused across results.
-- script.js --
const pick = (o, keys) => Object.fromEntries(keys.map(k => [k, o[k]]));
const prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service", state:"all"});
return prs.map(p => pick(p, ["number", "state"]));
