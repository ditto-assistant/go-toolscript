switch on a status string with fallthrough and default.
-- script.js --
const t = mcp.call("mcp__acme-tracker__list_tickets", {});
const counts = {active: 0, done: 0, other: 0};
for (const x of t.tickets) {
  switch (x.status) {
    case "open":
    case "pending":
      counts.active++;
      break;
    case "closed":
      counts.done++;
      break;
    default:
      counts.other++;
  }
}
return counts;
