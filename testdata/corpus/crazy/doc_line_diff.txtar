Line-level diff of two document versions using an LCS table, rendered as +/- lines.
-- script.js --
const a = mcp.googledocs.get_document_plaintext({document_id: "doc_abc", revision: "r1"}).plain_text.split("\n");
const b = mcp.googledocs.get_document_plaintext({document_id: "doc_abc", revision: "r2"}).plain_text.split("\n");
const n = a.length, m = b.length;
const L = [];
for (let i = 0; i <= n; i++) { L.push(new Array(m + 1).fill(0)); }
for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--)
  L[i][j] = a[i] === b[j] ? L[i + 1][j + 1] + 1 : Math.max(L[i + 1][j], L[i][j + 1]);
const out = [];
let i = 0, j = 0;
while (i < n && j < m) {
  if (a[i] === b[j]) { out.push("  " + a[i]); i++; j++; }
  else if (L[i + 1][j] >= L[i][j + 1]) { out.push("- " + a[i]); i++; }
  else { out.push("+ " + b[j]); j++; }
}
while (i < n) out.push("- " + a[i++]);
while (j < m) out.push("+ " + b[j++]);
const stats = {added: out.filter(l => l[0] === "+").length, removed: out.filter(l => l[0] === "-").length, same: L[0][0]};
return {stats, diff: out.join("\n")};
-- tools.json --
{
  "googledocs.get_document_plaintext": {
    "$sequence": [
      {
        "plain_text": "Title\nGoals\nShip v2\nRisks\nHiring\nOwner: Alice"
      },
      {
        "plain_text": "Title\nGoals\nShip v2 by October\nRisks\nHiring\nVendor delay\nOwner: Bob"
      }
    ]
  }
}
