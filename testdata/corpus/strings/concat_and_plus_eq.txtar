Building a string with += and concat().
-- script.js --
const ev = mcp.googlecalendar.events_list({calendarId:"primary"}).items;
let s = "Agenda:";
for (const e of ev) s += "\n* " + e.summary;
return s.concat("\n", "(", String(ev.length), " items)");
-- tools.json --
