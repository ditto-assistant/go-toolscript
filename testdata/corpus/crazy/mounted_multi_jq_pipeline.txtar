Two large mounted results reshaped with jq via bash, joined in JS, written back through a tool.
-- script.js --
const a = mcp.googledrive.find_file({q: "trashed = false", pageSize: 1000});
const b = mcp.search_memories({queries: ["file mentions"], limit: 200});
const files = bash(`jq -c '[.files[] | {id, name, modifiedTime}]' ${a.path}`).json || [];
const mentions = bash(`jq -c '[.queries[0].results[] | select(.file_id != null) | {file_id, id}]' ${b.path}`).json || [];
const counts = {};
for (const m of mentions) counts[m.file_id] = (counts[m.file_id] || 0) + 1;
const ranked = files.map(f => ({...f, mentions: counts[f.id] || 0}))
  .filter(f => f.mentions > 0)
  .sort((x, y) => y.mentions - x.mentions || (x.name < y.name ? -1 : 1));
const body = ranked.map((f, i) => `${i + 1}. ${f.name} — ${f.mentions} mention${f.mentions === 1 ? "" : "s"} (updated ${f.modifiedTime.slice(0, 10)})`).join("\n");
const note = mcp.notes.create({title: "Most-referenced files", body});
return {files: files.length, mentions: mentions.length, top: ranked.slice(0, 3).map(f => f.name), note: note.id};
