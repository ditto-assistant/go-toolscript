Build lines array then log once with join.
-- script.js --
const ev = mcp.googlecalendar.events_list({calendarId:"primary"}).items;
const lines = ev.map(e => `- ${e.summary} @ ${e.start.dateTime || e.start.date}`);
console.log(lines.join("\n"));
return lines.length;
