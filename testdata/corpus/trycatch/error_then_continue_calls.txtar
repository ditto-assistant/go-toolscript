A failed call does not stop subsequent calls.
-- script.js --
let first = null;
try { first = mcp.search_memories({queries:["x"]}); } catch (e) { first = "unavailable"; }
const second = mcp.fetch_memories({ids:["mem_001"]});
return {first, second: second.memories.length};
