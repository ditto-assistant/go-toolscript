Promise.all over two calls destructured into consts.
-- script.js --
const [a, b] = await Promise.all([
  mcp.linear.list_issues({team: "ENG"}),
  mcp.github.list_pull_requests({owner: "acme", repo: "widget-service"})
]);
return {issues: a.nodes.length, prs: b.length};
