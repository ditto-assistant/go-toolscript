Pre/post increment, compound assignment and comma in for.
-- script.js --
const r = mcp.linear.list_issues({team:"ENG"});
let total = 0, n = 0;
for (let i = 0, j = r.nodes.length - 1; i <= j; i++, j--) {
  total += r.nodes[i].estimate;
  if (i !== j) total += r.nodes[j].estimate;
  n++;
}
let x = 5; x *= 2; x -= 3; x %= 4; x **= 2;
return {total, n, x, pre: ++n, post: n++, after: n};
