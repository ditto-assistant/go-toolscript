at() with negative index, findLast and findLastIndex.
-- script.js --
const r = mcp.notes.list_scores({});
return [r.items.at(-1).id, r.items.at(0).id, r.items.findLast(i => i.team === "red").id, r.items.findLastIndex(i => i.team === "blue")];
