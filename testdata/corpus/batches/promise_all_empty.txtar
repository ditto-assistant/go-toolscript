Promise.all over an empty list returns an empty array.
-- script.js --
const r = await mcp.search_memories({queries: ["nothing"]});
const ids = r.queries[0].results.map(x => x.id);
const full = await Promise.all(ids.map(id => mcp.fetch_memories({ids: [id]})));
return {ids, full};
