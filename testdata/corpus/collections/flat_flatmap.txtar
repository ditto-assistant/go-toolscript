flat and flatMap over nested tag arrays.
-- script.js --
const r = mcp.notes.list_scores({});
return {
  flat: r.items.map(i => i.tags).flat(),
  flatMap: r.items.flatMap(i => i.tags.map(t => i.id + "#" + t)),
  deep: [1, [2, [3, [4]]]].flat(2)
};
