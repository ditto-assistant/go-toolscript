Identity and equality of arrays/objects returned from repeated JSON parses and slices.
-- script.js --
const r = mcp.list.get({});
const a = r.items, b = r.items.slice(), c = JSON.parse(JSON.stringify(r.items));
return [a === b, a == b, a == c, a == "a,b", [a] == "a,b", a.toString() === b.toString(), JSON.stringify(a) === JSON.stringify(c), {} == "[object Object]", [] + [] === "", [] + {} , typeof ([] + 1), [1] * [2], [1, 2] * 2, {} + 1, null + "x", undefined + 1, true + true, "3" - - "3"];
-- tools.json --
{
  "list.get": {
    "items": [
      "a",
      "b"
    ]
  }
}
