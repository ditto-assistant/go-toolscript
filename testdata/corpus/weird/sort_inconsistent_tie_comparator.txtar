Comparator `a.score > b.score ? -1 : 1` never returns 0; order of ties depends on the sort algorithm.
-- script.js --
const rows = mcp.board.list({}).rows;
const sorted = rows.slice().sort((a, b) => a.score > b.score ? -1 : 1).map(r => r.id);
const sorted2 = rows.slice().sort((a, b) => a.score < b.score ? 1 : -1).map(r => r.id);
return {sorted, sorted2};
