Object.groupBy / Map.groupBy / Set union a model assumes exist.
-- script.js --
const rows = mcp.crm.rows({}).rows;
const out = {};
const t = (k, f) => { try { out[k] = f(); } catch (e) { out[k] = e.name + ": " + e.message; } };
t("groupBy", () => JSON.stringify(Object.groupBy(rows, r => r.region)));
t("union", () => [...new Set([1, 2]).union(new Set([2, 3]))]);
return out;
-- tools.json --
{
  "crm.rows": {
    "rows": [
      {
        "region": "EU",
        "n": 3
      },
      {
        "region": "US",
        "n": 1
      }
    ]
  }
}
