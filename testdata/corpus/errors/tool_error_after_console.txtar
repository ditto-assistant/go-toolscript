Console output before an uncaught tool failure should still be captured.
-- script.js --
console.log("step 1: listing");
const prs = mcp.github.list_pull_requests({owner: "acme", repo: "widget-service"});
console.log("step 2: found", prs.length);
const f = mcp.github.get_file_contents({owner: "acme", repo: "widget-service", path: "CHANGELOG.md"});
return f;
