Loop over workspace files building a jq script per file.
-- script.js --
const out = {};
for (const f of workspace_files()) {
  if (!f.path.endsWith(".json")) continue;
  const x = bash(`jq 'type' ${f.path}`);
  out[f.path] = x.json;
}
return out;
