Stringify each item and keep adding while under a byte budget.
-- script.js --
const r = mcp.notes.search({query: "*"});
const out = [];
let used = 2;
for (const n of r.notes) {
  const s = JSON.stringify(n);
  if (used + s.length + 1 > 600) break;
  out.push(n);
  used += s.length + 1;
}
return {kept: out.length, of: r.notes.length, bytes: JSON.stringify(out).length};
