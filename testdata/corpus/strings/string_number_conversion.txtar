String(x), Number(x), parseInt, parseFloat on tool strings.
-- script.js --
const f = mcp.googledrive.find_file({q:"name = 'budget.xlsx'"}).files[0];
const bytes = Number(f.size);
return {
  kb: bytes / 1024, asInt: parseInt("42px", 10), hex: parseInt("ff", 16),
  float: parseFloat("3.75 units"), bad: Number("abc"), empty: Number(""),
  str: String(bytes), plus: "" + 7 + 3, sum: 7 + 3 + ""
};
