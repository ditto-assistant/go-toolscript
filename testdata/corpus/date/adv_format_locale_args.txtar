toLocale*String with locale and options arguments; other methods ignore extra arguments.
-- script.js --
const d = new Date(Date.UTC(2026, 8, 26, 14, 30, 15, 123));
return [d.toLocaleString("en-US"), d.toLocaleString("de-DE", { timeZone: "Asia/Tokyo" }), d.toLocaleDateString(undefined, { weekday: "long" }), d.toLocaleTimeString([], { hour: "2-digit" }), d.toString(123), d.toISOString("x"), d.toUTCString(undefined)];
-- tools.json --
{}
-- divergence --
Goja ignores toLocale*String arguments; the native engine formats through Intl.DateTimeFormat as ECMA-402 specifies (English data only: "de-DE" resolves to "en-US"), matching Node/ICU for English locales.
