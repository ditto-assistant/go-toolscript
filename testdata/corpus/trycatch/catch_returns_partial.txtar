Partial results preserved when a later call fails.
-- script.js --
const result = {prs: null, issues: null, errors: []};
try { result.prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service"}).length; } catch (e) { result.errors.push(String(e)); }
try { result.issues = mcp.github.search_issues({query:"is:open"}).result.total_count; } catch (e) { result.errors.push(String(e)); }
return result;
