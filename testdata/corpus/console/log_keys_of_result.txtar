Log Object.keys of an unknown response to explore its shape.
-- script.js --
const r = mcp.notion.fetch_data({id:"page_1"});
console.log("KEYS:", JSON.stringify(Object.keys(r)));
console.log("type of blocks:", typeof r.blocks, Array.isArray(r.blocks));
return Object.keys(r).length;
-- tools.json --
