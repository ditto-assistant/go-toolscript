Markdown table padded by .length with CJK and emoji (visually misaligned but deterministic).
-- script.js --
const items = mcp.tasks.list({}).items;
const cols = ["title", "owner", "points"];
const w = cols.map(c => Math.max(c.length, ...items.map(i => String(i[c] ?? "—").length)));
const row = vals => "| " + vals.map((v, i) => String(v ?? "—")[i === 2 ? "padStart" : "padEnd"](w[i])).join(" | ") + " |";
const out = [row(cols), "|" + w.map((n, i) => (i === 2 ? "-".repeat(n + 1) + ":" : "-".repeat(n + 2))).join("|") + "|", ...items.map(i => row(cols.map(c => i[c])))];
console.log(out.join("\n"));
return w;
-- tools.json --
