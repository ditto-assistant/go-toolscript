reduce into an object keyed by team (grouping).
-- script.js --
const r = mcp.notes.list_scores({});
const groups = r.items.reduce((acc, i) => {
  (acc[i.team] = acc[i.team] || []).push(i.name);
  return acc;
}, {});
return groups;
