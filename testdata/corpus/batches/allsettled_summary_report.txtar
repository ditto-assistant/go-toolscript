allSettled across many sources, then a summary string with failures listed.
-- script.js --
const names = ["memories", "docs", "drive", "calendar"];
const settled = await Promise.allSettled([
  mcp.search_memories({queries: ["weekly report"]}),
  mcp.googledocs.search_documents({query: "name contains 'weekly'"}),
  mcp.googledrive.find_file({q: "name contains 'weekly'"}),
  mcp.googlecalendar.events_list({calendarId: "primary"})
]);
const lines = settled.map((s, i) => s.status === "fulfilled" ? `✓ ${names[i]}` : `✗ ${names[i]}: ${s.reason?.message ?? s.reason}`);
return lines.join("\n");
