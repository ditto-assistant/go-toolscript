Nested try blocks with an inner fallback to a different tool.
-- script.js --
let doc;
try {
  try {
    doc = mcp.googledocs.get_document_by_id({id: "doc_old"});
  } catch (inner) {
    console.log("primary failed:", inner.message);
    doc = mcp.googledrive.export_document({fileId: "doc_abc", mimeType: "application/json"});
  }
  return doc.title;
} catch (outer) {
  return "both failed: " + String(outer);
}
