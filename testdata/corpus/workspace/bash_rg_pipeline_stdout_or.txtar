jq | rg | head pipeline with the x.stdout||x idiom.
-- script.js --
const x=bash("jq -r '.plain_text' /results/004-googledocs-get-document-plaintext.json | rg -n 'Risks|Owner|Timeline' | head -50"); return x.stdout||x;
