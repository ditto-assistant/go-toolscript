~20KB payload: filter, rank, group, and emit a report capped by a character budget.
-- script.js --
const r = mcp.notes.export_all({format: "json"});
const items = r.items;
const MAX = 2500;
const ranked = items.filter(i => i.score >= 0.5).sort((a, b) => b.score - a.score || (a.id < b.id ? -1 : 1));
const perOwner = {};
for (const i of ranked) {
  const o = perOwner[i.owner] || (perOwner[i.owner] = {count: 0, top: []});
  o.count++;
  if (o.top.length < 3) o.top.push(i.id);
}
let out = `total=${items.length} kept=${ranked.length}\n`;
for (const owner of Object.keys(perOwner).sort()) out += `${owner}: ${perOwner[owner].count} (top ${perOwner[owner].top.join(", ")})\n`;
out += "---\n";
for (const i of ranked) {
  const line = `${i.id} ${i.score.toFixed(2)} ${i.title.slice(0, 40).trim()}${i.tags.length ? " #" + i.tags.join(" #") : ""}\n`;
  if (out.length + line.length > MAX) { out += `…and ${ranked.length - ranked.indexOf(i)} more`; break; }
  out += line;
}
console.log("bytes in:", JSON.stringify(r).length);
return out;
