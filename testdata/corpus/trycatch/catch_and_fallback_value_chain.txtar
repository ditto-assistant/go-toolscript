Chain of fallbacks across three tools.
-- script.js --
function first(...fns) {
  const errs = [];
  for (const f of fns) {
    try { return {value: f(), errs}; } catch (e) { errs.push(e.message); }
  }
  return {value: null, errs};
}
return first(
  () => mcp.search_web({query: "widget"}).results[0].url,
  () => mcp.notes.search({query: "widget"}).notes[0].id,
  () => mcp.search_memories({queries: ["widget"]}).queries[0].results[0].id
);
