String methods on tool-provided values of other types.
-- script.js --
const r = mcp.crm.get({});
return [String(r.n).padStart(5, "0"), (r.n + "").length, r.s.toUpperCase(), String(r.b), String(r.arr), r.n.toFixed(1), `${r.obj}`, String(r.nil)];
-- tools.json --
{
  "crm.get": {
    "n": 42.25,
    "s": "straße",
    "b": false,
    "arr": [
      1,
      [
        2,
        3
      ]
    ],
    "obj": {
      "a": 1
    },
    "nil": null
  }
}
