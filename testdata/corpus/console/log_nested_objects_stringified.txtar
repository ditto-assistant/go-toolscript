Nested objects stringified inside a template literal.
-- script.js --
const r = mcp["team-backroom"].get_review({submissionId:"sub_77"});
console.log(`checks=${JSON.stringify(r.checks)}`);
console.log(`failed=${r.checks.filter(c => !c.passed).map(c => c.name)}`);
return r.status;
-- tools.json --
{
  "team-backroom.get_review": {
    "submission_id": "sub_77",
    "status": "open",
    "score": 0.72,
    "reviewer": "reviewer-3",
    "checks": [
      {
        "name": "lint",
        "passed": true
      },
      {
        "name": "tests",
        "passed": false,
        "detail": "2 failing"
      }
    ]
  }
}
