switch with return in each case inside a helper.
-- script.js --
function icon(kind) {
  switch (kind) {
    case "application/vnd.google-apps.folder": return "[dir]";
    case "application/vnd.google-apps.document": return "[doc]";
    default: return "[file]";
  }
}
const r = mcp.googledrive.find_file({q:"'root' in parents"});
return r.files.map(f => icon(f.mimeType) + " " + f.name).join("\n");
