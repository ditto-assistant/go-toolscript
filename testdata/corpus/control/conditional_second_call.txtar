Second call made only when the first result requires it.
-- script.js --
const r = mcp.googledocs.search_documents({query:"name = 'Q3 Planning'"});
if (r.documents.length === 0) return "missing";
const d = mcp.googledocs.get_document_by_id({id: r.documents[0].id});
return d.title + " (" + d.tabs.length + " tab)";
