Function composition via reduce.
-- script.js --
const pipe = (...fns) => x => fns.reduce((v, f) => f(v), x);
const onlyOpen = xs => xs.filter(p => p.state === "open");
const titles = xs => xs.map(p => p.title);
const upper = xs => xs.map(t => t.toUpperCase());
const prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service", state:"all"});
return pipe(onlyOpen, titles, upper)(prs);
