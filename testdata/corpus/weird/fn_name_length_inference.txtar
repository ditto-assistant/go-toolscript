Dispatch table of handlers; model logs handler.name/length and fn source for debugging.
-- script.js --
const r = mcp.events.list({});
const handlers = {
  created: (e) => "new " + e.id,
  deleted: function (e, why = "n/a", ...rest) { return "gone " + e.id; },
  ["up" + "dated"]: e => "upd " + e.id,
  renamed: function renamedHandler(e) { return "ren " + e.id; },
};
const fallback = (e) => "??? " + e.type;
const anon = [function () {}, () => {}][0];
const out = r.events.map(e => { const h = handlers[e.type] || fallback; return `${h.name}/${h.length}: ${h(e)}`; });
return {out, anonName: JSON.stringify(anon.name), toolName: typeof mcp.events.list.name, arrowSrc: String(handlers.created), fnSrcStart: handlers.deleted.toString().slice(0, 30)};
-- tools.json --
