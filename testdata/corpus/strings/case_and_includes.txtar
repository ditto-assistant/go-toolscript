toLowerCase/toUpperCase with includes for keyword filtering.
-- script.js --
const r = mcp.gmail.fetch_emails({query:"in:inbox"});
const kw = "INVOICE";
return r.messages.filter(m => (m.subject + " " + m.snippet).toLowerCase().includes(kw.toLowerCase())).map(m => m.id);
-- tools.json --
