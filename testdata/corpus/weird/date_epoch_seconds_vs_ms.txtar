Timestamps in seconds vs ms from different tools; model detects units by magnitude and formats relative ages.
-- script.js --
const evs = mcp.feed.list({}).events;
const now = Date.now();
const toMs = t => typeof t === "string" ? Date.parse(t) : t < 1e12 ? t * 1000 : t;
const rel = ms => { const s = Math.round((now - ms) / 1000); const a = Math.abs(s); const unit = a < 60 ? [a, "s"] : a < 3600 ? [Math.floor(a / 60), "m"] : a < 86400 ? [Math.floor(a / 3600), "h"] : [Math.floor(a / 86400), "d"]; return (s < 0 ? "in " : "") + unit.join("") + (s < 0 ? "" : " ago"); };
return evs.map(e => { const ms = toMs(e.t); return [e.id, isNaN(ms) ? "invalid" : new Date(ms).toISOString(), isNaN(ms) ? "?" : rel(ms)]; });
