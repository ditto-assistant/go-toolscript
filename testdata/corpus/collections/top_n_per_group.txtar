Top item per group via reduce and comparator.
-- script.js --
const r = mcp.notes.list_scores({});
const best = {};
for (const i of r.items) {
  if (!best[i.team] || i.score > best[i.team].score) best[i.team] = i;
}
return Object.keys(best).sort().map(k => `${k}: ${best[k].name}`);
