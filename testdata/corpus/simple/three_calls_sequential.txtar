Three calls in sequence, results returned in an array.
-- script.js --
const a = mcp.linear.list_issues({team:"ENG", first: 10});
const b = mcp.gmail.fetch_emails({query:"is:unread", max_results: 5});
const c = mcp.googlecalendar.events_list({calendarId:"primary"});
return [a.nodes.length, b.messages.length, c.items.length];
