new Map() / new Set() for grouping and dedupe.
-- script.js --
const r = mcp.search_memories({queries: ["billing", "launch", "design"]});
const ids = new Set();
const byQuery = new Map();
for (const q of r.queries) {
  byQuery.set(q.query, q.results.length);
  q.results.forEach(x => ids.add(x.id));
}
return {unique: ids.size, perQuery: [...byQuery.entries()]};
