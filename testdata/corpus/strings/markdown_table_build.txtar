Build a markdown table string from rows.
-- script.js --
const prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service", state:"all"});
const head = "| # | Title | Author | Labels |\n|---:|---|---|---|";
const body = prs.map(p => `| ${p.number} | ${p.title} | @${p.user.login} | ${p.labels.map(l => l.name).join(", ") || "-"} |`).join("\n");
return head + "\n" + body;
