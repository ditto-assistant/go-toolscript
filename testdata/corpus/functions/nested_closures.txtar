Nested closures sharing state across levels.
-- script.js --
function outer() {
  const log = [];
  function middle(prefix) {
    return function inner(x) { log.push(prefix + x); return log.length; };
  }
  const a = middle("A:"), b = middle("B:");
  const prs = mcp.github.list_pull_requests({owner:"acme", repo:"widget-service"});
  prs.forEach(p => (p.state === "open" ? a : b)(p.number));
  return log;
}
return outer();
