mount_result(ref) re-mounts a durable result by ref.
-- script.js --
const f = mount_result("cmr_test_002search");
const x = bash(`jq -r '.queries[0].results[0].summary' ${f.path}`);
return {file: f.path, bytes: f.bytes, first: x.stdout.trim()};
