bash .json value passed straight into a later tool call.
-- script.js --
const ids = bash("jq -c '[.queries[0].results[].id]' /results/002-search-memories.json").json;
const full = mcp.fetch_memories({ids});
return full.memories.map(m => m.content.slice(0, 40));
