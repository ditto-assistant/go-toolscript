Object.create(null) as a word-count dictionary with prototype-ish words.
-- script.js --
const cfg = mcp.cfg.get({});
const dict = Object.create(null);
for (const w of cfg.words) dict[w] = (dict[w] || 0) + 1;
return {json: JSON.stringify(dict), keys: Object.keys(dict), has: "toString" in dict};
-- tools.json --
{
  "cfg.get": {
    "words": [
      "a",
      "constructor",
      "a",
      "toString",
      "valueOf"
    ]
  }
}
