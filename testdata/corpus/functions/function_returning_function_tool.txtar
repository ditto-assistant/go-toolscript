Factory creating per-server lookup functions.
-- script.js --
const lookup = (server) => (id) => server === "crm" ? mcp.crm.get_account({id}).name : mcp["team-backroom"].get_review({submissionId: id}).status;
const crm = lookup("crm"), br = lookup("backroom");
return [crm("acct_9"), br("sub_77")];
