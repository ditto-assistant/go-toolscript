Every branch of the ISO parser: signs, 6-digit years, missing parts, T without seconds, fraction lengths, offsets.
-- script.js --
const inputs = ["2026", "2026-09", "2026-09-26", "2026-9-26", "2026-09-6", "+2026-09-26", "+002026", "-002026-01-01", "-000000-01-01", "+000000-01-01T00:00Z",
  "2026-09-26T10:20", "2026-09-26T10", "2026-09-26T10:20:3", "2026-09-26T1:20", "2026-09-26T10:20:30.", "2026-09-26T10:20:30.1", "2026-09-26T10:20:30.12",
  "2026-09-26T10:20:30.1234", "2026-09-26T10:20:30,5Z", "2026-09-26T10:20:30.1234567891Z", "2026-09-26T10:20Z", "2026-09-26T10:20+05", "2026-09-26T10:20+0530",
  "2026-09-26T10:20+05:30", "2026-09-26T10:20-05:3", "2026-09-26T10:20+5", "2026-09-26T10:20+24:00", "2026-09-26T10:20+23:60", "2026-09-26Z", "2026Z", "2026-09Z",
  "2026-09-26+01:00", "2026-09-26T24:00", "2026-09-26T24:00:00.001", "2026-09-26T23:60", "2026-09-26T23:59:60", "2026-00-10", "2026-09-00", "2026-02-31", "2026-09-32",
  "2026-09-26t10:20", "2026-09-26 10:20", "2026-09-26T10:20:30ZZ", "2026-09-26T10:20:30 Z", "+275760-09-13T00:00:00Z", "+275760-09-13T00:00:00.001Z", "-271821-04-20T00:00:00Z", "-271821-04-19T23:59:59.999Z"];
return inputs.map(s => [s, String(Date.parse(s))]);
