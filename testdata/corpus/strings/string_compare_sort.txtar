Plain < / > string comparison (not localeCompare) for sorting.
-- script.js --
const r = mcp.googledrive.find_file({q:"trashed = false"});
const names = r.files.map(f => f.name.toLowerCase());
names.sort((a, b) => a < b ? -1 : a > b ? 1 : 0);
return names;
-- tools.json --
