Large result mounted as a file; path interpolated into a jq script.
-- script.js --
const r = mcp.search_memories({queries: ["everything"], limit: 200});
const x = bash(`jq '[.queries[].results[] | .id] | length' ${r.path}`);
return {path: r.path, count: x.json};
