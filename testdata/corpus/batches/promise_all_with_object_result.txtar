Promise.all result mapped into an object keyed by source.
-- script.js --
const sources = ["gmail", "calendar", "tracker"];
const [mail, cal, trk] = await Promise.all([
  mcp.gmail.fetch_emails({query: "is:unread", max_results: 10}),
  mcp.googlecalendar.events_list({calendarId: "primary"}),
  mcp.call("mcp__acme-tracker__list_tickets", {status: "open"})
]);
const counts = [mail.messages.length, cal.items.length, trk.tickets.length];
return Object.fromEntries(sources.map((s, i) => [s, counts[i]]));
