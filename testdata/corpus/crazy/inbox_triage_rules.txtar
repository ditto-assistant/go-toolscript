          "UNREAD"
        ],
        "date": "2026-09-24T09:12:00Z"
      },
      {
        "id": "msg_2",
        "from": "billing@vendor.example",
        "subject": "Your invoice is ready",
        "snippet": "Invoice INV-0042 for September.",
        "labelIds": [
          "INBOX",
          "CATEGORY_UPDATES"
        ],
        "date": "2026-09-23T06:00:00Z"
      },
      {
        "id": "msg_3",
        "from": "bob@example.com",
        "subject": "Lunch?",
        "snippet": "Free Thursday?",
        "labelIds": [
          "INBOX"
        ],
        "date": "2026-09-22T18:30:00Z"
      }
    ],
    "nextPageToken": null
  },
  "gmail.modify_labels": {
    "ok": true
  },
  "gmail.create_draft": {
    "$sequence": [
      {
        "id": "draft_1"
      },
      {
        "id": "draft_2"
      }
    ]
  }
}
