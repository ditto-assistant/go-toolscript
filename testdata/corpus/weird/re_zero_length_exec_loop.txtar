exec loop with a pattern that can match empty; model's manual lastIndex bump guard.
-- script.js --
const s = mcp.text.get({}).s;
const re = /\d*/g;
const found = [];
let m, guard = 0;
while ((m = re.exec(s)) && guard++ < 20) {
  found.push([m[0], m.index]);
  if (m[0] === "") re.lastIndex++;
}
const all = s.match(/x*/g);
const rep = s.replace(/x*/g, "-");
const sp = s.split(/x*/);
return {found, all, rep, sp};
