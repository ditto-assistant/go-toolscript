Array.from with a length object and mapper, Array.of.
-- script.js --
const r = mcp.linear.list_issues({team:"ENG"});
const idx = Array.from({length: r.nodes.length}, (_, i) => i * 10);
return {idx, of: Array.of(7, 8), fromStr: Array.from("abc"), keys: [...r.nodes.keys()]};
